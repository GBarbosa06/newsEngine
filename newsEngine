#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPT_FILE="$SCRIPT_DIR/PROMPT.md"
SAMPLE_FILE="$SCRIPT_DIR/input/sample.json"

show_help() {
  echo "⚡ newsEngine CLI"
  echo ""
  echo "Uso:"
  echo "  ./newsEngine [opções|arquivo]"
  echo ""
  echo "Comandos integrados:"
  echo "  --copy <tema>     Preenche o tema no PROMPT.md em memória e copia para o CopyQ"
  echo "  --paste           Salva o clipboard do CopyQ direto em input/sample.json"
  echo "  -h, --help        Exibe esta mensagem de ajuda"
  echo ""
  echo "Geração de slides:"
  echo "  ./newsEngine                      Renderiza com o padrão (input/sample.json)"
  echo "  ./newsEngine <arquivo.json|yaml>   Renderiza a partir de um arquivo customizado"
  echo "  ./newsEngine [opções do motor]     Repassa flags (--theme, --handle, -o)"
  echo ""
  echo "Exemplo de fluxo rápido:"
  echo "  1. ./newsEngine --copy \"Novidades do Go 1.24\""
  echo "  2. (Gere na IA e copie a resposta)"
  echo "  3. ./newsEngine --paste"
  echo "  4. ./newsEngine"
}

case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
  --copy)
    shift
    THEME="$*"
    if [ -z "$THEME" ]; then
      echo "Erro: Informe o tema após --copy."
      echo "Exemplo: ./newsEngine --copy \"Novidades do Java 27\""
      exit 1
    fi

    if [ ! -f "$PROMPT_FILE" ]; then
      echo "Erro: Arquivo PROMPT.md não encontrado em $PROMPT_FILE"
      exit 1
    fi

    ESCAPED_THEME=$(printf '%s\n' "$THEME" | sed -e 's/[\/&]/\\&/g')

    if command -v copyq >/dev/null 2>&1; then
      sed "s/\[DIGITE SEU TÓPICO AQUI\]/$ESCAPED_THEME/g" "$PROMPT_FILE" | copyq copy -
      echo "✅ Prompt sobre \"$THEME\" copiado para o CopyQ!"
    elif command -v wl-copy >/dev/null 2>&1; then
      sed "s/\[DIGITE SEU TÓPICO AQUI\]/$ESCAPED_THEME/g" "$PROMPT_FILE" | wl-copy
      echo "✅ Prompt sobre \"$THEME\" copiado (wl-copy)!"
    elif command -v xclip >/dev/null 2>&1; then
      sed "s/\[DIGITE SEU TÓPICO AQUI\]/$ESCAPED_THEME/g" "$PROMPT_FILE" | xclip -selection clipboard
      echo "✅ Prompt sobre \"$THEME\" copiado (xclip)!"
    else
      echo "❌ Utilitário 'copyq' não encontrado no PATH."
      exit 1
    fi
    exit 0
    ;;
--paste)
    mkdir -p "$SCRIPT_DIR/input"

    TMP_FILE="$(mktemp)"
    trap 'rm -f "$TMP_FILE"' EXIT

    # 1. Copia o clipboard diretamente para um arquivo temporário.
    #    Nenhuma variável Bash toca no conteúdo do JSON.
    if command -v copyq >/dev/null 2>&1; then
        copyq clipboard > "$TMP_FILE"
    elif command -v wl-paste >/dev/null 2>&1; then
        wl-paste > "$TMP_FILE"
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o > "$TMP_FILE"
    else
        echo "❌ Nenhum utilitário de clipboard encontrado."
        exit 1
    fi

    # 2. Remove somente fences Markdown.
    sed \
        -e '/^[[:space:]]*```json[[:space:]]*$/d' \
        -e '/^[[:space:]]*```JSON[[:space:]]*$/d' \
        -e '/^[[:space:]]*```[[:space:]]*$/d' \
        "$TMP_FILE" > "$SAMPLE_FILE"

    # 3. Valida e, se necessário, tenta reparar campos "code".
    node - "$SAMPLE_FILE" <<'NODE'
const fs = require("fs");

const file = process.argv[2];
let text = fs.readFileSync(file, "utf8");

function validate(json) {
    try {
        JSON.parse(json);
        return null;
    } catch (err) {
        return err;
    }
}

let error = validate(text);

// Já está correto: não mexe em absolutamente nada.
if (!error) {
    console.log("✅ JSON já estava válido. Nenhum reparo necessário.");
    process.exit(0);
}

console.log("⚠️ JSON recebido está inválido:");
console.log(`   ${error.message}`);
console.log("🔧 Tentando reparar campos \"code\"...");

/*
 * Localiza:
 *
 *     "code": " ... "
 *
 * e determina onde o valor realmente termina olhando o que vem
 * depois da aspas.
 *
 * Aspas internas como:
 *
 *     -> "byte: " + b
 *
 * não são seguidas por ',' ou '}', então são transformadas em:
 *
 *     -> \"byte: \" + b
 */

function repairCodeFields(input) {
    const marker = /"code"\s*:\s*"/g;

    let result = "";
    let cursor = 0;
    let match;
    let repairs = 0;

    while ((match = marker.exec(input)) !== null) {
        const valueStart = marker.lastIndex;

        result += input.slice(cursor, valueStart);

        let i = valueStart;
        let value = "";

        while (i < input.length) {
            const ch = input[i];

            // Sequência já escapada: preserva exatamente.
            if (ch === "\\") {
                value += ch;

                if (i + 1 < input.length) {
                    value += input[i + 1];
                    i += 2;
                } else {
                    i++;
                }

                continue;
            }

            if (ch === '"') {
                /*
                 * Verifica o que existe depois da aspas.
                 *
                 * Se for:
                 *
                 *   ,
                 *   }
                 *   ]
                 *
                 * consideramos que esta aspas realmente encerra
                 * o valor JSON.
                 */
                let j = i + 1;

                while (
                    j < input.length &&
                    /\s/.test(input[j])
                ) {
                    j++;
                }

                const next = input[j];

                if (
                    next === "," ||
                    next === "}" ||
                    next === "]" ||
                    j >= input.length
                ) {
                    value += '"';
                    i++;
                    break;
                }

                // Aspas pertencentes ao código.
                value += '\\"';
                repairs++;
                i++;
                continue;
            }

            value += ch;
            i++;
        }

        result += value;
        cursor = i;
        marker.lastIndex = i;
    }

    result += input.slice(cursor);

    return {
        text: result,
        repairs
    };
}

const repaired = repairCodeFields(text);
const repairedError = validate(repaired.text);

if (repairedError) {
    console.error("❌ Não foi possível reparar o JSON automaticamente.");
    console.error(`   ${repairedError.message}`);
    console.error("");
    console.error("O arquivo original foi mantido sem alterações.");
    process.exit(1);
}

// Só sobrescreve depois de confirmar que o JSON reparado é válido.
fs.writeFileSync(file, repaired.text, "utf8");

console.log(
    `✅ JSON reparado com sucesso (${repaired.repairs} aspas corrigidas).`
);
NODE

    STATUS=$?

    if [ "$STATUS" -ne 0 ]; then
        exit "$STATUS"
    fi

    echo "✅ Conteúdo salvo em: input/sample.json"
    exit 0
    ;;
  *)
    if [ $# -eq 0 ]; then
      node "$SCRIPT_DIR/src/index.js" "$SAMPLE_FILE"
    else
      node "$SCRIPT_DIR/src/index.js" "$@"
    fi
    ;;
esac
